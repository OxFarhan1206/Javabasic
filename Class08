    System.out.println("THe value of x is : " + x);

}
}
# 
public class Class1 {
    public static void main(String[] args) {
        int x;
        x = 5;
    System.out.println("Current value of x is:" + x++);
    System.out.println("Current value of x is:" + ++x);

    x =  5;

    System.out.println("Current value of x is:" + x--);
    System.out.println("Current value of x is:" + --x);

    
}
}
