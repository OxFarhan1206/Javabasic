# avarage
public class Class1 {
    public static void main(String[] args) {
     int a,b,c;
     a = 10;
     b = -5;
     c = 20;

     float avg;
     avg = (a + b + c) / 3;

     System.out.println("Average of a, b, c is: " + avg);
}
}
# For full fraction value
public class Class1 {
    public static void main(String[] args) {
     int a,b,c;
     a = 10;
     b = -5;
     c = 20;

     float avg;
     avg = (float) (a + b + c) / 3;

     System.out.println("Average of a, b, c is: " + avg);
}
}
